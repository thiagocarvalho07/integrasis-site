/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=31536000, must-revalidate

/assets/media/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=604800, must-revalidate
